# Copy to .env.local for development, or set on the VPS for production.
# Nothing here is committed. .env.local is gitignored by default.

# --- Franchise lead delivery (required in production) ---------------------
# Without these the form returns a 500 and the visitor is told to retry,
# rather than the lead being silently dropped.
RESEND_API_KEY=
FRANCHISE_INBOX=franchise@example.com
# Must be a domain verified in Resend. The default sandbox sender only
# delivers to the account owner's own address.
FRANCHISE_FROM=TIANLALA <franchise@tianlala.sa>

# --- Analytics (optional; scripts do not load unless set) -----------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
